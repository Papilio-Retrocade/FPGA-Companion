# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.3.0 Project Minimal Configuration
#
CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=y
CONFIG_BT_GATTC_NOTIF_REG_MAX=16
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_SECTOR_512=y
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FREERTOS_HZ=1000
CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# Primary console must be USB Serial/JTAG (not UART0) so all boot/debug output
# actually appears on the same USB port used for flashing/monitoring.
# Default (UART0 primary + USB Serial/JTAG as output-only secondary) means
# nothing is ever connected to stdout on boards that only wire out the USB port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── WiFi UDP Logging ────────────────────────────────────────────────────────
# On your PC run:  ncat -u -l 7777   (Windows / Nmap)
#                  nc -u -l -p 7777  (Linux / macOS)
CONFIG_WIFI_LOG_ENABLE=y
# WiFi credentials — copy sdkconfig.defaults.local.example to sdkconfig.defaults.local and set real values there
CONFIG_WIFI_LOG_SSID="YourSSID"
CONFIG_WIFI_LOG_PASSWORD="YourPassword"
# ────────────────────────────────────────────────────────────────────────────

# ── Network Recovery / ROM Loading ──────────────────────────────────────────
# OTA/JTAG/firmware updates are handled by papilio-esp-bootloader now; this
# app just keeps POST /goto-loader (reboot into the loader) and POST
# /rom-load (upload+hot-insert a ROM/cart/disk image to the SD card).
CONFIG_NET_RECOVERY_ENABLE=y
CONFIG_NET_RECOVERY_PORT=3232
# CORS origin for browser-based tooling (e.g. papilioworks.com/flash fetch()).
# "*" works for local testing; set to your hosting domain for production.
CONFIG_NET_RECOVERY_CORS_ALLOW_ORIGIN="*"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_app.csv"
# Set to match your actual flash chip size (4MB is typical for SuperMini ESP32-S3)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
# ────────────────────────────────────────────────────────────────────────────

