# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 6.0.1 Project Minimal Configuration
#
CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=y
CONFIG_BT_GATTC_NOTIF_REG_MAX=16
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_SECTOR_512=y
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_USE_STRFUNC_WITHOUT_CRLF_CONV=y
CONFIG_FREERTOS_HZ=1000
CONFIG_WL_SECTOR_SIZE_512=y

# ── USB Hub Support ─────────────────────────────────────────────────────────
# Requires ESP-IDF 6.0+. Enables USB hub support so multiple HID devices
# can be connected through a USB hub. ESP32-S3 has 8 host channels total;
# practical limit is 2-3 HID devices through a single hub.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=y
# ────────────────────────────────────────────────────────────────────────────

# ── WiFi UDP Logging ────────────────────────────────────────────────────────
# On your PC run:  ncat -u -l 7777   (Windows / Nmap)
#                  nc -u -l -p 7777  (Linux / macOS)
CONFIG_WIFI_LOG_ENABLE=y
# WiFi credentials — copy sdkconfig.defaults.local.example to sdkconfig.defaults.local and set real values there
CONFIG_WIFI_LOG_SSID="YourSSID"
CONFIG_WIFI_LOG_PASSWORD="YourPassword"
# ────────────────────────────────────────────────────────────────────────────
